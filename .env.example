# --- LLM providers (fallback chain order: Gemini -> Groq -> DeepSeek) ---
# Missing keys are skipped gracefully; the chain falls through to the next tier.
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# --- Enrichment ---
GITHUB_TOKEN=            # raises GitHub API rate limit 60/hr -> 5000/hr

# --- Crawler tuning ---
MAX_CONCURRENCY=32       # global concurrent requests
PER_DOMAIN_CONCURRENCY=4 # politeness cap per domain
REQUEST_TIMEOUT=30       # seconds
DATA_DIR=data
LOG_LEVEL=INFO

# --- Optional: proxy pool (comma-separated URLs) ---
PROXY_POOL=

# --- Optional: Google Sheets export ---
GOOGLE_SHEETS_CREDENTIALS=   # path to service-account JSON
GOOGLE_SHEET_ID=
